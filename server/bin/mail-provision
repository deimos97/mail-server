#!/usr/bin/env bash
# Operaciones privilegiadas que necesita la web. Corre como root; el usuario `portal` solo puede
# llamarlo con sudo (regla en /etc/sudoers.d/portal-mail-provision) y sin más privilegios.
# Todo argumento se valida aquí: la web no es de fiar.
#
#   mail-provision sign-profile        firma (CMS/DER) el .mobileconfig que llega por stdin
#                                      con el certificado de la web; lo devuelve por stdout
#   mail-provision kick <buzón>        cierra las conexiones abiertas (IMAP) de un buzón
#   mail-provision delete-content <buzón>
#                                      borra el correo de un buzón que la web ya ha marcado como borrado
#                                      (status='deleted', active=0). La fila se queda: el nombre sigue
#                                      ocupado durante la cuarentena (D-009)
#   mail-provision delete-pending <buzón>
#                                      quita la fila de un buzón `pending` (pago no completado en el alta):
#                                      nunca ha recibido correo, así que el nombre queda libre al momento
#   mail-provision purge-deleted       borra el correo que quede de buzones ya borrados y quita las filas
#                                      cuya cuarentena ha terminado (release_at, o deleted_at + QUARANTINE_DAYS):
#                                      el nombre queda libre. Lo lanza el timer mail-purge (root)
#   mail-provision process-exports     prepara las copias pedidas desde la web: por cada
#                                      EXPORTS/requests/<id>.req (contiene la dirección) deja
#                                      EXPORTS/files/<id>.zip (un .mbox por carpeta) o <id>.failed.
#                                      Lo lanza mail-export.path en cuanto aparece una petición
set -euo pipefail

CERT_DIR=/etc/letsencrypt/live/unagrandeylibre.es
MAX_PROFILE_BYTES=65536
QUARANTINE_DAYS=90
VMAIL=/var/vmail
EXPORTS=/var/www/portal/shared/exports

die() { echo "mail-provision: $*" >&2; exit 2; }

valid_mailbox() {
    [[ "$1" =~ ^[a-z0-9._-]{1,64}@[a-z0-9.-]{1,253}$ ]] || return 1
    # Solo buzones que existen (lo valida la BD, no la forma)
    [ "$(mysql -N -B mailserver -e "SELECT COUNT(*) FROM mailboxes WHERE email = '$1'")" = 1 ]
}

case "${1:-}" in
    sign-profile)
        [ $# -eq 1 ] || die "uso: sign-profile < perfil.mobileconfig"
        tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
        head -c $((MAX_PROFILE_BYTES + 1)) > "$tmp/in"
        [ "$(stat -c %s "$tmp/in")" -le $MAX_PROFILE_BYTES ] || die "perfil demasiado grande"
        grep -q '<string>com.apple.mail.managed</string>' "$tmp/in" || die "no es un perfil de correo"
        openssl smime -sign -nodetach -binary -outform der \
            -signer "$CERT_DIR/cert.pem" -inkey "$CERT_DIR/privkey.pem" -certfile "$CERT_DIR/chain.pem" \
            -in "$tmp/in"
        ;;
    kick)
        [ $# -eq 2 ] || die "uso: kick <buzón>"
        valid_mailbox "$2" || die "buzón no válido"
        doveadm kick "$2" >/dev/null || true   # sin conexiones abiertas también es éxito
        ;;
    delete-content)
        [ $# -eq 2 ] || die "uso: delete-content <buzón>"
        valid_mailbox "$2" || die "buzón no válido"
        row=$(mysql -N -B mailserver -e "SELECT m.local_part, d.name, m.tier FROM mailboxes m JOIN domains d ON d.id = m.domain_id
                                         WHERE m.email = '$2' AND m.status = 'deleted' AND m.active = 0")
        [ -n "$row" ] || die "el buzón no está marcado como borrado"
        read -r local domain tier <<< "$row"
        [ "$tier" != system ] || die "los buzones del sistema no se borran"
        [[ "$local" =~ ^[a-z0-9._-]{1,64}$ && "$local" != .* && "$domain" =~ ^[a-z0-9.-]{1,253}$ && "$domain" != .* ]] || die "ruta no válida"
        doveadm kick "$2" >/dev/null 2>&1 || true
        rm -rf -- "${VMAIL:?}/$domain/$local"
        mysql mailserver -e "DELETE FROM quota_usage WHERE username = '$2'; DELETE FROM last_logins WHERE username = '$2'"
        logger -t mail-provision "contenido borrado: $2"
        ;;
    delete-pending)
        [ $# -eq 2 ] || die "uso: delete-pending <buzón>"
        valid_mailbox "$2" || die "buzón no válido"
        row=$(mysql -N -B mailserver -e "SELECT m.local_part, d.name FROM mailboxes m JOIN domains d ON d.id = m.domain_id
                                         WHERE m.email = '$2' AND m.status = 'pending' AND m.active = 0")
        [ -n "$row" ] || die "el buzón no está pendiente"
        read -r local domain <<< "$row"
        [ ! -e "$VMAIL/$domain/$local" ] || die "el buzón tiene correo: no se borra"
        mysql mailserver -e "DELETE FROM mailboxes WHERE email = '$2' AND status = 'pending' AND active = 0"
        logger -t mail-provision "pendiente liberado: $2"
        ;;
    purge-deleted)
        [ $# -eq 1 ] || die "uso: purge-deleted"
        # 1) Buzones que la web ha dado por borrados sin poder borrar su correo (ciclo de vida: impago,
        #    inactividad; el scheduler de la web no puede usar sudo): se borra ahora
        mysql -N -B mailserver -e "SELECT m.email, m.local_part, d.name FROM mailboxes m JOIN domains d ON d.id = m.domain_id
                                   WHERE m.status = 'deleted' AND m.active = 0 AND m.tier <> 'system'" |
        while read -r email local domain; do
            [ -e "$VMAIL/$domain/$local" ] && "$0" delete-content "$email" || true
        done
        # 2) Nombres cuya cuarentena ha terminado
        mysql -N -B mailserver -e "SELECT m.email, m.local_part, d.name FROM mailboxes m JOIN domains d ON d.id = m.domain_id
                                   WHERE m.status = 'deleted' AND m.active = 0
                                     AND COALESCE(m.release_at, m.deleted_at + INTERVAL $QUARANTINE_DAYS DAY) < NOW()" |
        while read -r email local domain; do
            # Por si el borrado del contenido falló en su día: nunca se libera un nombre con correo dentro
            if [ -e "$VMAIL/$domain/$local" ]; then
                logger -t mail-provision "purge: $email aún tiene correo; no se libera"; continue
            fi
            mysql mailserver -e "DELETE FROM mailboxes WHERE email = '$email' AND status = 'deleted'"
            logger -t mail-provision "nombre liberado: $email"
        done
        ;;
    process-exports)
        [ $# -eq 1 ] || die "uso: process-exports"
        shopt -s nullglob
        for req in "$EXPORTS"/requests/*.req; do
            id=$(basename "$req" .req)
            email=$(head -c 400 "$req" | tr -d '[:space:]')
            rm -f "$req"
            [[ "$id" =~ ^[0-9]{1,12}$ ]] || { logger -t mail-provision "export: id no válido"; continue; }
            out="$EXPORTS/files/$id"
            if ! valid_mailbox "$email" \
               || [ "$(mysql -N -B mailserver -e "SELECT status FROM mailboxes WHERE email = '$email'")" = deleted ]; then
                logger -t mail-provision "export $id: buzón no válido"; touch "$out.failed"; chown portal:portal "$out.failed"; continue
            fi
            # Espacio: el mbox y el zip pueden ocupar hasta dos veces el buzón; deja siempre 2 GB libres
            local_part=${email%@*}; domain=${email#*@}
            need=$(( $(du -sb "$VMAIL/$domain/$local_part" 2>/dev/null | cut -f1 || echo 0) * 2 + 2 * 1024 * 1024 * 1024 ))
            free=$(( $(df --output=avail -B1 /var/tmp | tail -1) ))
            if [ "$free" -lt "$need" ]; then
                logger -t mail-provision "export $id: sin espacio"; touch "$out.failed"; chown portal:portal "$out.failed"; continue
            fi
            tmp=$(mktemp -d /var/tmp/mail-export.XXXXXX); chown vmail:vmail "$tmp"
            if doveadm -o namespace/inbox/separator=/ backup -u "$email" "mbox:$tmp/mbox:LAYOUT=fs" 2>/dev/null \
               && python3 - "$tmp/mbox" "$out.zip.part" <<'PY'
import os, sys, zipfile
src, dst = sys.argv[1], sys.argv[2]
names = {'inbox': 'Bandeja de entrada', 'Sent': 'Enviados', 'Drafts': 'Borradores', 'Junk': 'Spam', 'Trash': 'Papelera', 'Archive': 'Archivo'}
with zipfile.ZipFile(dst, 'w', zipfile.ZIP_DEFLATED, compresslevel=6) as z:
    for root, dirs, files in os.walk(src):
        dirs[:] = [d for d in dirs if not d.startswith('.')]
        for f in files:
            if f.startswith('.'):
                continue
            rel = os.path.relpath(os.path.join(root, f), src)
            name = names.get(rel, rel)
            z.write(os.path.join(root, f), name + '.mbox')
PY
            then
                mv "$out.zip.part" "$out.zip"; chown portal:portal "$out.zip"; chmod 640 "$out.zip"
                logger -t mail-provision "export $id listo: $email"
            else
                rm -f "$out.zip.part"; touch "$out.failed"; chown portal:portal "$out.failed"
                logger -t mail-provision "export $id falló: $email"
            fi
            rm -rf "$tmp"
        done
        ;;
    *)
        die "orden desconocida"
        ;;
esac
