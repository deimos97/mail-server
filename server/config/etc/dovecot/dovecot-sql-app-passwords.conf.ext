# Contraseñas por dispositivo (mailserver.app_passwords). Ver docs/front/ARCHITECTURE.md.
# El selector (6 primeros caracteres de la contraseña) localiza la fila; Dovecot compara el hash.
driver = mysql
connect = host=127.0.0.1 dbname=mailserver user=mailuser password=__REDACTED__
default_pass_scheme = BLF-CRYPT
password_query = SELECT m.email AS user, a.password, a.id AS userdb_app_password_id FROM app_passwords a JOIN mailboxes m ON m.id = a.mailbox_id JOIN domains d ON d.id = m.domain_id WHERE m.email = '%u' AND a.selector = LEFT('%w', 6) AND a.revoked_at IS NULL AND m.active = 1 AND m.status = 'active' AND d.active = 1
