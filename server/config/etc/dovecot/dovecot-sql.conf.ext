driver = mysql
connect = host=127.0.0.1 dbname=mailserver user=mailuser password=__REDACTED__
default_pass_scheme = BLF-CRYPT

password_query = SELECT m.email AS user, m.password FROM mailboxes m JOIN domains d ON d.id = m.domain_id WHERE m.email = '%u' AND m.active = 1 AND m.status = 'active' AND d.active = 1

user_query = SELECT '/var/vmail/%d/%n' AS home, 5000 AS uid, 5000 AS gid, CONCAT('*:bytes=', m.quota_bytes) AS quota_rule FROM mailboxes m JOIN domains d ON d.id = m.domain_id WHERE m.email = '%u' AND m.active = 1 AND d.active = 1

iterate_query = SELECT email AS user FROM mailboxes WHERE active = 1
