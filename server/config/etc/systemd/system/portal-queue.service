[Unit]
Description=Laravel queue worker (portal)
After=network.target mariadb.service

[Service]
User=portal
Group=portal
WorkingDirectory=/var/www/portal/current
ExecStart=/usr/bin/php8.3 artisan queue:work --sleep=3 --tries=3 --backoff=30 --max-time=3600 --memory=192
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
