APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# BD del correo: en local, SQLite aparte (database/mailserver.sqlite); en producción, MariaDB `mailserver`.
DB_MAILSERVER_DRIVER=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Servicios externos (valores reales solo en el .env del servidor) ---
# Stripe, modo test: Dashboard → Developers → API keys (pk_test_ / sk_test_).
# El webhook secret (whsec_) se crea al dar de alta el endpoint del webhook (Fase 4).
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=es_ES
STRIPE_KEY=""
STRIPE_SECRET=""
STRIPE_WEBHOOK_SECRET=""

# PostHog Cloud EU: Project settings → Project API key (phc_, es pública por diseño).
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_KEY=""

# Cloudflare Turnstile: Turnstile → Add site (dominio unagrandeylibre.es) → Site key / Secret key.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Alta: cerrada hasta el lanzamiento; acceso de pruebas con /alta?acceso=<token>
SIGNUP_OPEN=false
SIGNUP_PREVIEW_TOKEN=""

# Login único con el webmail (proveedor OAuth2 propio). El secreto también va en /etc/roundcube/config.inc.php
OAUTH_WEBMAIL_CLIENT_ID=webmail
OAUTH_WEBMAIL_CLIENT_SECRET=""
OAUTH_INTROSPECTION_IPS=127.0.0.1,::1

# Script privilegiado (server/bin/mail-provision) que la web llama con sudo. Vacío en local:
# perfiles de Apple sin firmar y sin cerrar conexiones. Producción: "/usr/bin/sudo -n /usr/local/sbin/mail-provision"
MAIL_PROVISION_COMMAND=

# Copias del correo: la web deja la petición y root (mail-export.path) deja el zip. Vacío = storage/app/exports.
# Producción: /var/www/portal/shared/exports
MAIL_EXPORT_DIR=

# IPs que pueden pedir los mapas internos para Rspamd (/internal/rspamd/…). Producción: 127.0.0.1,::1,128.140.5.221
INTERNAL_IPS=127.0.0.1,::1

# Textos legales: true muestra el aviso de borrador pendiente de revisión (quitarlo cuando la asesoría los apruebe)
LEGAL_DRAFT=true

# Página de estado: resumen que escribe mail-monitor. Producción: /var/www/portal/shared/status.json
STATUS_FILE=

# Conversiones de anuncios desde el servidor (en blanco = apagadas). Ver config/ads.php
META_PIXEL_ID=
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_SIGNUP_ACTION=
GOOGLE_ADS_PURCHASE_ACTION=
